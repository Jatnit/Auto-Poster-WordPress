# WP Auto Poster environment template
# Copy to .env only if you choose to manage secrets via environment variables.
# The current app also supports local JSON config through app_config.json.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# WordPress
WP_USERNAME=your-wordpress-username
WP_PASSWORD=your-wordpress-password
WP_LOGIN_URL=https://example.com/wp-login.php
WP_ADMIN_URL=https://example.com/wp-admin/

# AI Providers
AI_PROVIDER=ollama
GEMINI_API_KEY=your-gemini-api-key
OLLAMA_MODEL=llama3

# Automation Defaults
HEADLESS_MODE=false
POSTS_PER_DAY=2
DELAY_BETWEEN_REQUESTS=5
CONTENT_MIN_VALID_WORDS=1401
CONTENT_AUTO_RERENDER_RETRIES=2
