# WP Auto Poster - environment template
#
# Only the variables listed below are actually read by the application.
# Everything else (WordPress credentials, AI provider, schedule, prompts) is
# managed through the web UI and persisted to app_config.json /
# wp_site_presets.json, which are gitignored and written with 0600 permissions.
#
# Copy to .env for reference; the app reads these from the process
# environment, so export them or prefix them on the command line:
#   WP_PORT=5002 python app.py

# Bind address. Keep it on loopback: the control panel has no authentication,
# and requests arriving with a non-localhost Host header are rejected with 403.
WP_HOST=127.0.0.1

# Port for the web interface.
WP_PORT=5001

# Set to 1 to enable the Werkzeug debugger. Off by default.
# The auto-reloader stays disabled either way — it would restart the process
# on any file save and kill an automation run mid-post.
WP_DEBUG=0
